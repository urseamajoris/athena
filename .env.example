# --- Keys (server-side only; never exposed to the browser) ---
# The Anthropic API key (from https://platform.claude.com, starts with sk-ant-). Leave it empty to run and test
# without spending: AI steps then say "AI is not set up" and nothing is sent to the API. Set it only when you
# mean to spend. An admin can also set a key in the dashboard; that key is used in place of this one.
ANTHROPIC_API_KEY=
OPENALEX_API_KEY=
# Contact email sent to PubMed (email=), Crossref (mailto=) and Unpaywall (email=), as their terms ask.
CONTACT_EMAIL=
# Optional NCBI key raises PubMed from 3 to 10 requests/second.
NCBI_API_KEY=

# --- Models (checked against the API's model list when a key is set) ---
# Use model IDs exactly as Anthropic lists them, with no date suffix. An ID the key cannot use is replaced by the
# newest model of the same family (opus, sonnet, haiku, fable), and the admin dashboard says so.
# Fast role: scoping, question drafts, search building, ranking.
ANTHROPIC_MODEL_FAST=claude-opus-5-5
# Per-paper summary rows (defaults to the fast model).
ANTHROPIC_MODEL_SUMMARY=claude-opus-5-5
# Reasoning role: article analysis, synthesis, final research questions.
ANTHROPIC_MODEL_REASONING=claude-opus-5-5
# How hard the model works on each answer: low | medium | high | xhigh | max. It sets how much the model thinks,
# and thinking is billed as output, so higher costs more. Empty = the model's own default. Dropped for a model
# that does not accept it.
# The fast and summary roles:
AI_EFFORT_FAST=low
# The reasoning role:
AI_EFFORT_REASONING=medium

# --- Cost control ---
# Cap on TOTAL AI spend recorded in the database, in US dollars (all time and all accounts, not per month or per
# run); AI calls are refused once it is reached. Empty or 0 = no cap. An admin can set another limit in the
# dashboard; allowing more than this value needs a confirmation. Each account's own spending is limited by its
# credits (below).
AI_BUDGET_USD=
# Max concurrent per-paper model calls.
AI_CONCURRENCY=4

# --- Credits and payments ---
# Every account has computing credits; AI steps take credits and people buy more with Stripe.
# Credits given to each new account (default 100; 0 gives none).
SIGNUP_FREE_CREDITS=100
# Credits taken per US dollar of model cost (default 150).
CREDITS_PER_USD_COST=150
# Stripe secret key (sk_test_... or sk_live_...). Empty: buying credits is switched off; everything else works.
STRIPE_SECRET_KEY=
# Signing secret of the Stripe webhook endpoint (whsec_...). Empty: the webhook refuses every request.
STRIPE_WEBHOOK_SECRET=
# Public address of this site, used for Stripe's return links (e.g. https://athena.example.org). Empty: the
# address the request came to.
APP_URL=

# --- Retrieval ---
# Max records fetched per query (pagination stops here).
MAX_RESULTS_PER_QUERY=40
# Characters of full text sent to the model per article analysis (the UI states when text was truncated).
APPRAISAL_MAX_CHARS=60000
# HTTP cache lifetime in hours.
HTTP_CACHE_TTL_HOURS=168

# --- Environment ---
# production marks a deployed server (shown in /api/status and the admin dashboard). It does not decide whether
# AI runs: an API key does. The databases (PubMed, OpenAlex, Europe PMC, Crossref, Unpaywall) are always real.
ATHENA_ENV=
# Comma list of sources to force-fail, for testing failure handling: pubmed,openalex,crossref,unpaywall,europepmc
SIMULATE_SOURCE_FAILURE=
# Tests only: send model requests to another address instead of https://api.anthropic.com.
# (ANTHROPIC_BASE_URL is deliberately not read.)
ATHENA_ANTHROPIC_BASE_URL=
# Database: libSQL. Set both TURSO_* values to use a Turso database (production);
# leave TURSO_DATABASE_URL empty to use the local SQLite file at DATABASE_PATH (dev and tests).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Local SQLite file (used only when TURSO_DATABASE_URL is empty)
DATABASE_PATH=data/athena.db

# --- Accounts ---
# The first administrator, created at server start if no account has this email yet (an existing account
# with this email is made an admin only if ADMIN_PASSWORD is its password, which is not changed; nobody can
# sign up with this address). Projects created before accounts existed
# are assigned to the first admin. ADMIN_PASSWORD: at least 10 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# false = only the administrator can create accounts (sign-up page closed). Default: open.
ALLOW_SIGNUP=
# 32 random bytes (e.g. `openssl rand -base64 32`), or any string of 32+ characters. Encrypts the API key an
# admin sets in the dashboard (AES-256-GCM). Without it the dashboard refuses to store a key.
SETTINGS_ENCRYPTION_KEY=
