# --- Keys (server-side only; never exposed to the browser) ---
# Leave XAI_API_KEY empty to run and test without spending: AI steps then say "AI is not set up" and nothing is
# sent to xAI. Set it only when you mean to spend (an admin can also set a key in the dashboard).
XAI_API_KEY=
OPENALEX_API_KEY=
# Contact email sent to PubMed (email=), Crossref (mailto=) and Unpaywall (email=), as their terms ask.
CONTACT_EMAIL=
# Optional NCBI key raises PubMed from 3 to 10 requests/second.
NCBI_API_KEY=

# --- Models (checked against https://api.x.ai/v1/models when a key is set) ---
# Fast role: scoping, search building, per-paper summary rows, ranking.
XAI_MODEL_FAST=grok-4.3
# Per-paper summary rows (defaults to the fast model).
XAI_MODEL_SUMMARY=grok-4.3
# Reasoning role: appraisal, synthesis, research questions.
XAI_MODEL_REASONING=grok-4.20-0309-reasoning
# reasoning_effort for the fast models (low|medium|high, empty = model default). Ignored if a model rejects it.
XAI_FAST_REASONING_EFFORT=low

# --- Cost control ---
# Hard cap on TOTAL xAI spend recorded in the database (all time, not per month or per run); AI calls are refused
# once it is reached. An admin can lower it in the dashboard; raising it above this value needs a confirmation.
XAI_BUDGET_USD=5
# Max concurrent per-paper model calls.
AI_CONCURRENCY=4

# --- Retrieval ---
# Max records fetched per query (pagination stops here).
MAX_RESULTS_PER_QUERY=40
# Characters of full text sent to the model per appraisal (the UI states when text was truncated).
APPRAISAL_MAX_CHARS=60000
# HTTP cache lifetime in hours.
HTTP_CACHE_TTL_HOURS=168

# --- Environment ---
# production marks a deployed server (shown in /api/status and the admin dashboard). It does not decide whether
# AI runs: an xAI key does. The databases (PubMed, OpenAlex, Europe PMC, Crossref, Unpaywall) are always real.
ATHENA_ENV=
# Comma list of sources to force-fail, for testing failure handling: pubmed,openalex,crossref,unpaywall,europepmc
SIMULATE_SOURCE_FAILURE=
# Database: libSQL. Set both TURSO_* values to use a Turso database (production);
# leave TURSO_DATABASE_URL empty to use the local SQLite file at DATABASE_PATH (dev and tests).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Local SQLite file (used only when TURSO_DATABASE_URL is empty)
DATABASE_PATH=data/athena.db

# --- Accounts ---
# The first administrator, created at server start if no account has this email yet (an existing account
# with this email is made an admin only if ADMIN_PASSWORD is its password, which is not changed; nobody can
# sign up with this address). Projects created before accounts existed
# are assigned to the first admin. ADMIN_PASSWORD: at least 10 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# false = only the administrator can create accounts (sign-up page closed). Default: open.
ALLOW_SIGNUP=
# 32 random bytes (e.g. `openssl rand -base64 32`), or any string of 32+ characters. Encrypts the xAI key an
# admin sets in the dashboard (AES-256-GCM). Without it the dashboard refuses to store a key.
SETTINGS_ENCRYPTION_KEY=
